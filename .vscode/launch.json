{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Docker: Attach to PokeViewer.Web",
      "type": "coreclr",
      "request": "attach",
      "processId": "1",
      "preLaunchTask": "docker: up (debug)",
      "postDebugTask": "docker: down (debug)",
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": ["exec", "-i", "pokeviewer-debug"],
        "debuggerPath": "/vsdbg/vsdbg",
        "pipeCwd": "${workspaceFolder}",
        "quoteArgs": false
      },
      "sourceFileMap": {
        "/src": "${workspaceFolder}"
      },
      "justMyCode": true
    }
  ]
}
