@using System.Globalization

<article class="pokemon-card">
    @if (Pokemon.SpriteUrl is not null)
    {
        <img class="sprite" src="@Pokemon.SpriteUrl" alt="@Pokemon.Name" width="240" height="240" />
    }
    else
    {
        <div class="sprite missing" aria-hidden="true">?</div>
    }

    <h2>
        <span class="number">#@Pokemon.Id.ToString("000", CultureInfo.InvariantCulture)</span>
        <span class="name">@Pokemon.Name</span>
    </h2>

    <ul class="types" aria-label="Types">
        @foreach (var type in Pokemon.Types)
        {
            <li class="type type-@type.ToLowerInvariant()">@type</li>
        }
    </ul>

    @{
        var height = Measurements.FormatHeight(Pokemon, Units);
        var weight = Measurements.FormatWeight(Pokemon, Units);
    }
    <dl class="stats">
        <div>
            <dt>Height</dt>
            <dd class="height">
                <span aria-hidden="true">@height.Text</span>
                <span class="visually-hidden">@height.SpokenText</span>
            </dd>
        </div>
        <div>
            <dt>Weight</dt>
            <dd class="weight">
                <span aria-hidden="true">@weight.Text</span>
                <span class="visually-hidden">@weight.SpokenText</span>
            </dd>
        </div>
    </dl>

    <PokemonMoves Moveset="Pokemon.Moveset" />
</article>

@code {
    [Parameter, EditorRequired]
    public PokemonDto Pokemon { get; set; } = default!;

    [Parameter]
    public UnitSystem Units { get; set; }
}
