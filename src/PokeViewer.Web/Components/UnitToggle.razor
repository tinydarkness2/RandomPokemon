<div class="unit-picker">
    <span class="unit-label" id="unit-toggle-label">Height and weight units</span>
    <div class="unit-toggle" role="group" aria-labelledby="unit-toggle-label">
        @foreach (var option in Options)
        {
            <button type="button"
                    class="@(option == Value ? "selected" : null)"
                    aria-pressed="@(option == Value ? "true" : "false")"
                    @onclick="() => SelectAsync(option)">
                @option
            </button>
        }
    </div>
</div>

@code {
    private static readonly UnitSystem[] Options = Enum.GetValues<UnitSystem>();

    [Parameter]
    public UnitSystem Value { get; set; }

    [Parameter]
    public EventCallback<UnitSystem> ValueChanged { get; set; }

    private async Task SelectAsync(UnitSystem option)
    {
        if (option != Value)
        {
            await ValueChanged.InvokeAsync(option);
        }
    }
}
